import { useEffect, useState } from "react";
import { ClipLoader } from "react-spinners";
import { Select } from "../ui/form/Select";
import { usePsgcHook } from "../hooks/usePsgcHook";

type PSGCItem = {
    code: string;
    name: string;
};

type Province = PSGCItem & {
    prv: number;
    name: string;
};

type Municipality = PSGCItem & {
    mun: number;
    name: string;
};

type Region = PSGCItem & {
    reg: number;
};

type PSGCDropdownProps = {
    setAddressDetail: (value: string) => void;
    placeholder: string;
};

export const PSGCDropdown = ({
    setAddressDetail,
    placeholder,
}: PSGCDropdownProps) => {
    const {
        getRegions,
        getProvinces,
        getMunicipalities,
        getBarangays,
    } = usePsgcHook();

    const [regions, setRegions] = useState<Region[]>([]);
    const [provinces, setProvinces] = useState<Province[]>([]);
    const [municipalities, setMunicipalities] = useState<Municipality[]>([]);
    const [barangays, setBarangays] = useState<PSGCItem[]>([]);

    const [regionCode, setRegionCode] = useState("");
    const [provinceCode, setProvinceCode] = useState("");
    const [municipalityCode, setMunicipalityCode] = useState("");
    const [barangayCode, setBarangayCode] = useState("");

    const [fullAddress, setFullAddress] = useState("");

    const [loadingRegions, setLoadingRegions] = useState(false);
    const [loadingProvinces, setLoadingProvinces] = useState(false);
    const [loadingMunicipalities, setLoadingMunicipalities] =
        useState(false);
    const [loadingBarangays, setLoadingBarangays] = useState(false);

    const [manualRegion, setManualRegion] = useState("");
    const [manualProvince, setManualProvince] = useState("");
    const [manualMunicipality, setManualMunicipality] = useState("");
    const [manualBarangay, setManualBarangay] = useState("");

    // Load regions
    useEffect(() => {
        const load = async () => {
            try {
                setLoadingRegions(true);

                const data = await getRegions();

                setRegions(data);
            } catch (error) {
                console.error("Failed to load regions:", error);
                setRegions([]);
            } finally {
                setLoadingRegions(false);
            }
        };

        load();
    }, []);

    // Load provinces
    useEffect(() => {
        setProvinceCode("");
        setMunicipalityCode("");
        setBarangayCode("");

        setMunicipalities([]);
        setBarangays([]);

        setManualProvince("");
        setManualMunicipality("");
        setManualBarangay("");

        if (!regionCode) {
            setProvinces([]);
            return;
        }

        const load = async () => {
            try {
                setLoadingProvinces(true);

                const data = await getProvinces(regionCode);

                setProvinces(data);
            } catch (error) {
                console.error("Failed to load provinces:", error);
                setProvinces([]);
            } finally {
                setLoadingProvinces(false);
            }
        };

        load();
    }, [regionCode]);

    // Load municipalities
    useEffect(() => {
        setMunicipalityCode("");
        setBarangayCode("");

        setBarangays([]);

        setManualMunicipality("");
        setManualBarangay("");

        if (!provinceCode) {
            setMunicipalities([]);
            return;
        }

        const load = async () => {
            try {
                setLoadingMunicipalities(true);

                const data = await getMunicipalities(provinceCode);

                setMunicipalities(data);
            } catch (error) {
                console.error("Failed to load municipalities:", error);
                setMunicipalities([]);
            } finally {
                setLoadingMunicipalities(false);
            }
        };

        load();
    }, [provinceCode]);

    // Load barangays
    useEffect(() => {
        setBarangayCode("");
        setManualBarangay("");

        if (!municipalityCode || !provinceCode) {
            setBarangays([]);
            return;
        }

        const load = async () => {
            try {
                setLoadingBarangays(true);

                const data = await getBarangays(
                    municipalityCode,
                    provinceCode
                );

                setBarangays(data);
            } catch (error) {
                console.error("Failed to load barangays:", error);
                setBarangays([]);
            } finally {
                setLoadingBarangays(false);
            }
        };

        load();
    }, [municipalityCode, provinceCode]);

    // Manual region input
    const handleManualRegionChange = (
        e: React.ChangeEvent<HTMLInputElement>
    ) => {
        const value = e.target.value;

        setManualRegion(value);
        setFullAddress(value);

        setAddressDetail(value);
    };

    // Manual province input
    const handleManualProvinceChange = (
        e: React.ChangeEvent<HTMLInputElement>
    ) => {
        const value = e.target.value;

        setManualProvince(value);

        const newFullAddress = manualRegion
            ? `${manualRegion}, ${value}`
            : value;

        setFullAddress(newFullAddress);
        setAddressDetail(newFullAddress);
    };

    // Manual municipality input
    const handleManualMunicipalityChange = (
        e: React.ChangeEvent<HTMLInputElement>
    ) => {
        const value = e.target.value;

        setManualMunicipality(value);

        const parts = [
            manualRegion,
            manualProvince,
            value,
        ].filter(Boolean);

        const newFullAddress = parts.join(", ");

        setFullAddress(newFullAddress);
        setAddressDetail(newFullAddress);
    };

    // Manual barangay input
    const handleManualBarangayChange = (
        e: React.ChangeEvent<HTMLInputElement>
    ) => {
        const value = e.target.value;

        setManualBarangay(value);

        const parts = [
            manualRegion,
            manualProvince,
            manualMunicipality,
            value,
        ].filter(Boolean);

        const newFullAddress = parts.join(", ");

        setFullAddress(newFullAddress);
        setAddressDetail(newFullAddress);
    };

    return (
        <div className="mt-4 space-y-4">
            {/* Region */}
            <div className="relative">
                {loadingRegions ? (
                    <div className="flex items-center gap-2">
                        <span>Loading regions...</span>

                        <ClipLoader
                            size={18}
                            color="#6B7280"
                        />
                    </div>
                ) : regions.length === 0 ? (
                    <input
                        type="text"
                        value={manualRegion}
                        onChange={handleManualRegionChange}
                        placeholder="Enter region manually"
                        className="w-full"
                    />
                ) : (
                    <>
                        <Select
                            value={regionCode}
                            onChange={(e) => {
                                const name =
                                    e.target.options[
                                        e.target.selectedIndex
                                    ].text;

                                setRegionCode(e.target.value);

                                setFullAddress(name);

                                setAddressDetail(name);
                            }}
                            disabled={loadingRegions}
                        >
                            <option value="">
                                {placeholder}
                            </option>

                            {regions.map((region) => (
                                <option
                                    key={region.code}
                                    value={region.reg}
                                >
                                    {region.name}
                                </option>
                            ))}
                        </Select>

                        {loadingRegions && (
                            <div className="absolute right-10 top-1/2 -translate-y-1/2">
                                <ClipLoader
                                    size={18}
                                    color="#6B7280"
                                />
                            </div>
                        )}
                    </>
                )}
            </div>

            {/* Province */}
            <div className="relative">
                {loadingProvinces ? (
                    <div className="flex items-center gap-2">
                        <span>Loading provinces...</span>

                        <ClipLoader
                            size={18}
                            color="#6B7280"
                        />
                    </div>
                ) : provinces.length === 0 && regionCode ? (
                    <input
                        type="text"
                        value={manualProvince}
                        onChange={handleManualProvinceChange}
                        placeholder="Enter province manually"
                        className="w-full"
                    />
                ) : (
                    <>
                        <Select
                            value={provinceCode}
                            onChange={(e) => {
                                const name =
                                    e.target.options[
                                        e.target.selectedIndex
                                    ].text;

                                setProvinceCode(e.target.value);

                                const newFullAddress =
                                    `${fullAddress}, ${name}`;

                                setFullAddress(newFullAddress);

                                setAddressDetail(newFullAddress);
                            }}
                            disabled={!regionCode || loadingProvinces}
                        >
                            <option value="">
                                Select province
                            </option>

                            {provinces.map((province) => (
                                <option
                                    key={province.code}
                                    value={province.prv}
                                >
                                    {province.name}
                                </option>
                            ))}
                        </Select>

                        {loadingProvinces && regionCode && (
                            <div className="absolute right-10 top-1/2 -translate-y-1/2">
                                <ClipLoader
                                    size={18}
                                    color="#6B7280"
                                />
                            </div>
                        )}
                    </>
                )}
            </div>

            {/* Municipality / City */}
            <div className="relative">
                {loadingMunicipalities ? (
                    <div className="flex items-center gap-2">
                        <span>
                            Loading municipalities/cities...
                        </span>

                        <ClipLoader
                            size={18}
                            color="#6B7280"
                        />
                    </div>
                ) : municipalities.length === 0 && provinceCode ? (
                    <input
                        type="text"
                        value={manualMunicipality}
                        onChange={handleManualMunicipalityChange}
                        placeholder="Enter municipality/city manually"
                        className="w-full"
                    />
                ) : (
                    <>
                        <Select
                            value={municipalityCode}
                            onChange={(e) => {
                                const name =
                                    e.target.options[
                                        e.target.selectedIndex
                                    ].text;

                                setMunicipalityCode(e.target.value);

                                const newFullAddress =
                                    `${fullAddress}, ${name}`;

                                setFullAddress(newFullAddress);

                                setAddressDetail(newFullAddress);
                            }}
                            disabled={
                                !provinceCode ||
                                loadingMunicipalities
                            }
                        >
                            <option value="">
                                Select municipality/city
                            </option>

                            {municipalities.map((municipality) => (
                                <option
                                    key={municipality.code}
                                    value={municipality.mun}
                                >
                                    {municipality.name}
                                </option>
                            ))}
                        </Select>

                        {loadingMunicipalities && provinceCode && (
                            <div className="absolute right-10 top-1/2 -translate-y-1/2">
                                <ClipLoader
                                    size={18}
                                    color="#6B7280"
                                />
                            </div>
                        )}
                    </>
                )}
            </div>

            {/* Barangay */}
            <div className="relative">
                {loadingBarangays ? (
                    <div className="flex items-center gap-2">
                        <span>Loading barangays...</span>

                        <ClipLoader
                            size={18}
                            color="#6B7280"
                        />
                    </div>
                ) : barangays.length === 0 && municipalityCode ? (
                    <input
                        type="text"
                        value={manualBarangay}
                        onChange={handleManualBarangayChange}
                        placeholder="Enter barangay manually"
                        className="w-full"
                    />
                ) : (
                    <>
                        <Select
                            value={barangayCode}
                            onChange={(e) => {
                                const name =
                                    e.target.options[
                                        e.target.selectedIndex
                                    ].text;

                                const newFullAddress =
                                    `${fullAddress}, ${name}`;

                                setBarangayCode(e.target.value);

                                setFullAddress(newFullAddress);

                                setAddressDetail(newFullAddress);
                            }}
                            disabled={
                                !municipalityCode ||
                                loadingBarangays
                            }
                        >
                            <option value="">
                                Select barangay
                            </option>

                            {barangays.map((barangay) => (
                                <option
                                    key={barangay.code}
                                    value={barangay.code}
                                >
                                    {barangay.name}
                                </option>
                            ))}
                        </Select>

                        {loadingBarangays && municipalityCode && (
                            <div className="absolute right-10 top-1/2 -translate-y-1/2">
                                <ClipLoader
                                    size={18}
                                    color="#6B7280"
                                />
                            </div>
                        )}
                    </>
                )}
            </div>
        </div>
    );
};
